# =============================================================
# RightsFlow - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real credentials.
# =============================================================

# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/rightsflow
DATABASE_USERNAME=rightsflow
DATABASE_PASSWORD=rightsflow_secret
DATABASE_NAME=rightsflow

# ---- JWT ----
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# ---- AI Provider ----
# Options: openai, gemini, demo
AI_PROVIDER=demo
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---- File Storage ----
# Options: local, s3
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=./uploads
FILE_MAX_SIZE_MB=10

# ---- Server ----
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# ---- pgvector ----
PGVECTOR_DIMENSIONS=1536

# ---- Speech (Optional) ----
SPEECH_PROVIDER=browser
SPEECH_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO
